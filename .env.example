# ============================================================
# Local development (keep as-is for your laptop)
# ============================================================
APP_NAME=CineProxima API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cineproxima

# ============================================================
# Free deployment (see docs/free-hosting-guide.md)
# ============================================================
# Render blueprint:  render.yaml   (https://render.com)
# Koyeb definition:  koyeb.yaml    (https://koyeb.com)
# Free PostgreSQL:   Neon          (https://neon.tech) - permanently free 0.5 GB
# Large media files: Cloudflare R2 (https://dash.cloudflare.com -> R2) - 10 GB free

# When deploying, set these in the platform dashboard (not in this file):
#
# APP_ENV=production
# APP_HOST=0.0.0.0
# APP_PORT=8000
#
# FRONTEND_ORIGIN=https://<your-app-domain>   # e.g. https://vcnr-web.onrender.com
#
# DATABASE_URL=<Neon or Render Postgres connection string>
#   Example: postgresql+psycopg://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#
# Optional swarm connectivity:
# SWARM_STUN_URL=stun:stun.l.google.com:19302
# SWARM_TURN_URL=
# SWARM_TURN_USERNAME=
# SWARM_TURN_CREDENTIAL=
#
# Optional public torrent trackers (comma-separated):
# PUBLIC_TORRENT_TRACKERS=udp://tracker.opentrackr.org:1337/announce,udp://open.stealth.si:80/announce