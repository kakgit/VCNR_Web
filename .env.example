# ============================================================
# Local development (keep as-is for your laptop)
# ============================================================
APP_NAME=CineProxima API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cineproxima

# ============================================================
# Deployment (Railway app + Railway database - see docs/free-hosting-guide.md)
# ============================================================
# App platform: Railway (https://railway.com) - web service from root Dockerfile
#                (railway.json sets builder, start command, and health check)
# PostgreSQL:   Railway (trial credit, then Hobby $5/mo) - same project as the app
# Large media files: Cloudflare R2 (https://dash.cloudflare.com -> R2) - 10 GB free

# In the web service Variable tab, wire the database with the reference picker
# (Add Reference -> Postgres.DATABASE_URL), e.g.:
#
# DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# Railway resolves it to the private *.railway.internal URL that works inside the
# project (no sslmode / no public TCP proxy needed). Do NOT paste the value as
# literal text -- an unresolved reference or empty value now fails safe (the app
# boots and DB routes return 503) instead of crashing on startup.
#
# APP_ENV=production
# SWARM_STUN_URL=stun:stun.l.google.com:19302
#
# FRONTEND_ORIGIN is auto-detected from RAILWAY_PUBLIC_DOMAIN.
# Only override it if you need a custom domain:
# FRONTEND_ORIGIN=https://<your-app-domain>
#
# Public-proxy example (outside Railway, e.g. local dev against the cloud DB):
# DATABASE_URL=postgresql://postgres:password@xxxx.proxy.rlwy.net:PORT/railway?sslmode=require
#
# Optional swarm connectivity:
# SWARM_STUN_URL=stun:stun.l.google.com:19302
# SWARM_TURN_URL=
# SWARM_TURN_USERNAME=
# SWARM_TURN_CREDENTIAL=
#
# Cross-network WebRTC peer delivery (phone-to-phone on different Wi-Fi / mobile data):
#  1. Run a public STUN/TURN server (e.g. coturn on a small VPS) or use a managed
#     provider (Cloudflare Calls TURN, Twilio Network Traversal, metered.network).
#  2. Fill the four variables. The app's WebRTC seeder/receiver path then works
#     through symmetric NAT / CGNAT / mobile data instead of only on LAN.
# Example with coturn:
# SWARM_STUN_URL=stun:turn.example.com:3478
# SWARM_TURN_URL=turns:turn.example.com:5349?transport=tcp
# SWARM_TURN_USERNAME=vcnr-relay
# SWARM_TURN_CREDENTIAL=<long-random-secret>
#
# Optional swarm control:
# SWARM_MAX_RECEIVERS_PER_SEEDER=8
# SWARM_SEEDER_TTL_SECONDS=300
#
# Optional public torrent trackers (comma-separated):
# PUBLIC_TORRENT_TRACKERS=udp://tracker.opentrackr.org:1337/announce,udp://open.stealth.si:80/announce
#
# Optional Cloudflare R2 permanent storage for encrypted content chunks.
# When configured, uploaded chunks are mirrored to R2, chunk downloads redirect
# to R2's CDN, and torrent webseed URLs point at R2's public bucket URL.
#
# 1. Create an R2 bucket (e.g. vcnr-content) in Cloudflare dashboard.
# 2. Create an R2 Access Key with Admin read/write permission.
# 3. Enable "Public access" on the bucket to get a public base URL, e.g.
#    https://pub-xxxxxxxxxxxx.r2.dev
# 4. Set these variables (leave blank to keep local-disk storage only):
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=vcnr-content
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev
#
# Optional Expo push access token.
# Push alerts (for example the "download is confirmed" message that must reach
# viewers whose app is closed) are sent through https://exp.host without any
# token by default. Set this only if the Expo project enforces push security:
# EXPO_ACCESS_TOKEN=your-expo-access-token
#
# ============================================================
# Optional SMTP delivery for advertisement gift QR emails.
# When a customer submits an advertisement, the backend renders a
# cinevault://movie QR code and emails it to the recipient viewer so they can
# scan it inside the app to receive the sponsored movie.
# Works with Gmail (use an App Password), Outlook, Mailgun, SendGrid, etc.
# ============================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-address@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=your-address@gmail.com
# SMTP_FROM_NAME=Cine Vault
# SMTP_USE_TLS=true   # set false only for plain local relays; port 465 uses SSL automatically
